# Helios Multi-Tenant Backend Configuration
# -------------------------------------------------------------
# Environment & Application
ENVIRONMENT=development
PROJECT_NAME="Helios Multi-Tenant Data Platform"
API_V1_STR=/api/v1

# Security & Authentication
# Secret key for JWT encoding and decoding (generate with openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Bootstrap (used by scripts/bootstrap_admin.py)
BOOTSTRAP_ADMIN_EMAIL=admin@helios.local
BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password_123!

# Symmetric Credential Encryption Key for Tenant Credentials
# Must be a 32-byte URL-safe base64-encoded key (generate with cryptography.fernet.Fernet.generate_key())
CREDENTIAL_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key_here=

# Databricks SQL Connector (Free Edition / Unity Catalog)
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/endpoints/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=helios_catalog
DATABRICKS_SCHEMA=default

# CORS Configuration (JSON array of strings or comma-separated list)
# In development, allows all origins by default
BACKEND_CORS_ORIGINS=["*"]
